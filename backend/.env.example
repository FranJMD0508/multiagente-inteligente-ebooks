# Copia este archivo como backend/.env y rellena lo que necesites.
# Todas las variables son opcionales: sin ninguna clave, Folio funciona con el proveedor "demo".

# ----- Proveedor de LLM -----
# gemini (por defecto) | anthropic | openai | demo
# Si el proveedor elegido no tiene clave, se usa "demo" y se avisa en el log al arrancar.
LLM_PROVIDER=gemini

# Google Gemini (plan gratuito en https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Medido el 2026-10-27 con el plan gratuito: unos 10 s por capítulo y cuota suficiente para
# varios libros al día. gemini-3.5-flash escribe algo mejor (unos 17 s por capítulo) pero su cuota
# diaria gratuita se agota con un solo libro; gemini-3.8-flash tardó unos 80 s (no cumple RNF-02).
# Nivel de razonamiento (thinkingLevel). Vacío = no se envía. Si el modelo no lo admite, se quita solo.
GEMINI_THINKING_LEVEL=low
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Esfuerzo de razonamiento (low | medium | high | xhigh | max). Vacío = no se envía.
# Los modelos actuales de Claude no admiten "temperature": el tono lo fijan los prompts.
ANTHROPIC_EFFORT=low

# OpenAI (o cualquier API compatible con OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=

# Tiempo máximo de una llamada al LLM que no es un capítulo (segundos)
LLM_TIMEOUT_S=60
# Tiempo máximo de una petición JSON completa, con sus reintentos y esperas (segundos)
LLM_JSON_TIMEOUT_S=150
# Pausa entre trozos de texto del proveedor demo (ms). 0 = instantáneo.
DEMO_DELAY_MS=35
# Solo para probar la interfaz: fallos simulados del proveedor demo, separados por comas,
# con la forma tarea[@capítulo][xveces]. Ejemplo: redactor.capitulo@4x2 hace fallar dos
# veces el capítulo 4 (el intento y el reintento automático) para ver el botón "Reintentar".
# DEMO_FAIL=

# ----- Pipeline -----
# Tiempo límite por intento al escribir un capítulo (RNF-02). Hay un reintento automático.
CHAPTER_TIMEOUT_S=60
# Pausa entre capítulos que aparecen uno a uno en el índice (ms)
UI_STEP_DELAY_MS=300

# ----- Datos y seguridad -----
# Carpeta de SQLite (folio.sqlite y checkpoints.sqlite). Relativa a backend/.
DATA_DIR=data
# Clave para firmar los tokens (JWT HS256). Vacía = se genera y se guarda en data/secret.key.
SECRET_KEY=
# Días de validez de la sesión
ACCESS_TOKEN_DAYS=30

# ----- Web -----
# URL del frontend (para el enlace de recuperar contraseña que se imprime en el log)
FRONTEND_URL=http://localhost:3000
# Orígenes permitidos por CORS, separados por comas
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100

# ----- Referencias (Crossref y Open Library) -----
# Correo de contacto que se envía en el User-Agent (recomendado por Crossref)
CROSSREF_MAILTO=
# false = no se consulta la red; las referencias quedan "sin_verificar"
REFERENCES_LOOKUP=true
REFERENCES_TIMEOUT_S=8

# ----- PDF -----
# Navegador de Playwright: msedge (por defecto en Windows), chrome, o vacío = Chromium de Playwright
# (instálalo con: python -m playwright install chromium)
# PDF_BROWSER_CHANNEL=msedge
# Tiempo máximo para generar un PDF (segundos)
PDF_TIMEOUT_S=90

LOG_LEVEL=INFO
