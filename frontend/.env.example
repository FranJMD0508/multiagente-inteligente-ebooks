# Copia este archivo como .env.local para conectar el frontend al backend.
#
# mock  → modo demo: los cuatro agentes se simulan en el navegador (es lo que se
#         publica en GitHub Pages). No hace falta backend.
# http  → agentes reales: el frontend habla con FastAPI + LangGraph (backend/).
NEXT_PUBLIC_API_MODE=http

# URL del backend (sin barra final). Por defecto, el servidor local.
NEXT_PUBLIC_API_URL=http://localhost:8000
